# Copy to .env and fill in. NEVER commit .env (see .gitignore + gitleaks in CI).

# --- Postgres ---
# 5433, not 5432: a native Postgres install commonly owns 5432, and on Windows two
# processes CAN bind the same port — so the clash shows up not as "address in use"
# but as your app silently talking to the wrong database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tradeforge
POSTGRES_USER=tradeforge
POSTGRES_PASSWORD=change-me
# The database's memory, sized for the Docker VM it shares with the workers (ADR-0036). Unset, it
# is 6GB/20GB, measured for a 44 GB VM. With a 22 GB VM (a 32 GB machine), about 3GB/10GB.
# Takes effect when the postgres container is recreated.
# POSTGRES_SHARED_BUFFERS=6GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=20GB

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backtest workers ---
# One worker is one core: a backtest is synchronous CPU. Raise this for sweeps; 12 keeps an
# i9-14900K (32 threads) near 40% busy. Change it only with the backtest queue empty — the
# workers are recreated, and a recreated worker drops the run it was in the middle of.
TRADEFORGE_WORKERS=1
# The memory one worker may use, swap included (15/10): past it, that worker alone is killed and
# its batch goes to another. Leave it unless a chart heavier than M5 over a decade needs more.
# The count times this, plus Postgres' buffers (6 GB unless set above), has to fit the Docker VM
# (.wslconfig).
# TRADEFORGE_WORKER_MEMORY=5g

# --- MetaTrader 5 terminal (Windows hosts only: collector + executor) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# --- Execution safeguards (see sdd.md §11) ---
KILL_SWITCH_ENABLED=true
MAX_DAILY_LOSS_PERCENT=3.0
MAX_OPEN_POSITIONS=1
