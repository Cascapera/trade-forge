# Copy to worker.env on the machine that runs extra workers (docker-compose.worker.yml).
# NEVER commit worker.env: it holds the database password.

# The main machine's address on the local network — where Postgres and Redis are published.
TRADEFORGE_HOST=192.168.0.10

# As in the main machine's .env. POSTGRES_PORT is the PUBLISHED port (5433 there by default).
POSTGRES_PORT=5433
POSTGRES_DB=tradeforge
POSTGRES_USER=tradeforge
POSTGRES_PASSWORD=change-me
REDIS_PORT=6379

# How many workers this machine runs: one core each. Leave cores for the machine itself.
TRADEFORGE_WORKERS=8

# Where this machine keeps its copy of the main machine's data/ohlcv.
TRADEFORGE_CANDLES=./data/ohlcv
