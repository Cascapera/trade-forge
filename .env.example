# Copy to .env and fill in. NEVER commit .env (see .gitignore + gitleaks in CI).

# --- Postgres ---
# 5433, not 5432: a native Postgres install commonly owns 5432, and on Windows two
# processes CAN bind the same port — so the clash shows up not as "address in use"
# but as your app silently talking to the wrong database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tradeforge
POSTGRES_USER=tradeforge
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backtest workers ---
# One worker is one core: a backtest is synchronous CPU. Raise this for sweeps; 12 keeps an
# i9-14900K (32 threads) near 40% busy. Change it only with the backtest queue empty — the
# workers are recreated, and a recreated worker drops the run it was in the middle of.
TRADEFORGE_WORKERS=1

# --- MetaTrader 5 terminal (Windows hosts only: collector + executor) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# --- Execution safeguards (see sdd.md §11) ---
KILL_SWITCH_ENABLED=true
MAX_DAILY_LOSS_PERCENT=3.0
MAX_OPEN_POSITIONS=1
