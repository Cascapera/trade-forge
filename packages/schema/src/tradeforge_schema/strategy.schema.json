{
  "$defs": {
    "AllOf": {
      "additionalProperties": false,
      "description": "Logical AND.",
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "minItems": 1,
          "title": "All",
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnyOf": {
      "additionalProperties": false,
      "description": "Logical OR.",
      "properties": {
        "any": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "minItems": 1,
          "title": "Any",
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "AverageKind": {
      "enum": [
        "EMA",
        "SMA"
      ],
      "type": "string"
    },
    "CandleExtremeParams": {
      "additionalProperties": false,
      "properties": {
        "lookback": {
          "maximum": 100,
          "minimum": 1,
          "title": "Lookback",
          "type": "integer"
        },
        "side": {
          "enum": [
            "low",
            "high"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "lookback",
        "side"
      ],
      "title": "CandleExtremeParams",
      "type": "object"
    },
    "CandleExtremeStop": {
      "additionalProperties": false,
      "description": "Stop at the low (or high) of the last N closed candles.",
      "properties": {
        "params": {
          "$ref": "#/$defs/CandleExtremeParams"
        },
        "type": {
          "const": "candle_extreme",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "params"
      ],
      "title": "CandleExtremeStop",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "description": "A leaf: two operands and an operator.\n\n`gt` asks about this candle. `crosses_above` asks about this candle *and the\nprevious one* — it is true only on the bar where the relation flips, which is\nwhat stops a strategy from re-entering on every bar of a trend it already owns.",
      "properties": {
        "left": {
          "$ref": "#/$defs/Operand"
        },
        "op": {
          "$ref": "#/$defs/ComparisonOp"
        },
        "right": {
          "$ref": "#/$defs/Operand"
        }
      },
      "required": [
        "op",
        "left",
        "right"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "ComparisonOp": {
      "enum": [
        "gt",
        "lt",
        "gte",
        "lte",
        "crosses_above",
        "crosses_below",
        "breaks_above",
        "breaks_below"
      ],
      "type": "string"
    },
    "Condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Comparison"
        },
        {
          "$ref": "#/$defs/AllOf"
        },
        {
          "$ref": "#/$defs/AnyOf"
        },
        {
          "$ref": "#/$defs/NotOf"
        }
      ]
    },
    "Constant": {
      "additionalProperties": false,
      "description": "A literal number — the fixed side of a threshold like `RSI < 30`. It references nothing,\nso the semantic layer skips it; `inf`/`nan` are rejected because no comparison means them.",
      "properties": {
        "value": {
          "examples": [
            30,
            70,
            0.0
          ],
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "Constant",
      "type": "object"
    },
    "ContinuationParams": {
      "additionalProperties": false,
      "description": "`max_bos` caps how many breaks after a change of character may still be traded.\n\n`null` is uncapped, which is the default and not a degenerate setting: \"every favourable\nbreak re-arms\" is a real reading of the method, and capping it is the experiment.",
      "properties": {
        "allow_secondary": {
          "default": false,
          "title": "Allow Secondary",
          "type": "boolean"
        },
        "breakeven_at_r": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 2.0,
          "title": "Breakeven At R"
        },
        "max_bos": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Bos"
        },
        "stop_buffer": {
          "default": 0.1,
          "maximum": 10,
          "minimum": 0,
          "title": "Stop Buffer",
          "type": "number"
        }
      },
      "title": "ContinuationParams",
      "type": "object"
    },
    "EMA": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 40,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PeriodSourceParams"
        },
        "type": {
          "const": "EMA",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "EMA",
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "description": "Entry conditions per side. A strategy must trade at least one of them.",
      "properties": {
        "long": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "short": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Entry",
      "type": "object"
    },
    "Exit": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "stop_loss": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandleExtremeStop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "take_profit": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskMultipleTakeProfit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Exit",
      "type": "object"
    },
    "Indicator": {
      "discriminator": {
        "mapping": {
          "EMA": "#/$defs/EMA",
          "RSI": "#/$defs/RSI",
          "SMA": "#/$defs/SMA"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SMA"
        },
        {
          "$ref": "#/$defs/EMA"
        },
        {
          "$ref": "#/$defs/RSI"
        }
      ]
    },
    "Mme9BreakoutParams": {
      "additionalProperties": false,
      "description": "The break of the candle that closed across the MME9 (ADR-0016).",
      "properties": {
        "breakeven_at_r": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 2.0,
          "title": "Breakeven At R"
        },
        "period": {
          "default": 9,
          "maximum": 1000,
          "minimum": 1,
          "title": "Period",
          "type": "integer"
        },
        "side": {
          "$ref": "#/$defs/SetupSide"
        },
        "stop_buffer_ticks": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Stop Buffer Ticks",
          "type": "integer"
        }
      },
      "required": [
        "side"
      ],
      "title": "Mme9BreakoutParams",
      "type": "object"
    },
    "Mme9BreakoutSetup": {
      "additionalProperties": false,
      "properties": {
        "params": {
          "$ref": "#/$defs/Mme9BreakoutParams"
        },
        "type": {
          "const": "mme9_breakout",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "params"
      ],
      "title": "Mme9BreakoutSetup",
      "type": "object"
    },
    "NotOf": {
      "additionalProperties": false,
      "description": "Logical NOT. Serialised as `not`, which is a Python keyword — hence the alias.",
      "properties": {
        "not": {
          "$ref": "#/$defs/Condition"
        }
      },
      "required": [
        "not"
      ],
      "title": "NotOf",
      "type": "object"
    },
    "Operand": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "$ref": "#/$defs/Constant"
        }
      ]
    },
    "PercentRiskParams": {
      "additionalProperties": false,
      "properties": {
        "percent": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Percent",
          "type": "number"
        }
      },
      "required": [
        "percent"
      ],
      "title": "PercentRiskParams",
      "type": "object"
    },
    "PercentRiskSizing": {
      "additionalProperties": false,
      "description": "Size the position so that hitting the stop costs `percent` of the account.",
      "properties": {
        "params": {
          "$ref": "#/$defs/PercentRiskParams"
        },
        "type": {
          "const": "percent_risk",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "params"
      ],
      "title": "PercentRiskSizing",
      "type": "object"
    },
    "PeriodSourceParams": {
      "additionalProperties": false,
      "description": "A window length and which price it reads — shared by every single-period indicator\n(SMA, EMA, RSI, and ATR to come). Named for its shape, not for one indicator, because a\nperiod over a price source is exactly what they all take.",
      "properties": {
        "period": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Period",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/PriceSource",
          "default": "close"
        }
      },
      "required": [
        "period"
      ],
      "title": "PeriodSourceParams",
      "type": "object"
    },
    "PontoContinuoParams": {
      "additionalProperties": false,
      "description": "Two corrections back to the average, then the bar that touches it and closes back.",
      "properties": {
        "average": {
          "$ref": "#/$defs/AverageKind",
          "default": "EMA"
        },
        "breakeven_at_r": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 2.0,
          "title": "Breakeven At R"
        },
        "period": {
          "default": 20,
          "maximum": 1000,
          "minimum": 1,
          "title": "Period",
          "type": "integer"
        },
        "side": {
          "$ref": "#/$defs/SetupSide"
        },
        "stop_buffer_ticks": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Stop Buffer Ticks",
          "type": "integer"
        }
      },
      "required": [
        "side"
      ],
      "title": "PontoContinuoParams",
      "type": "object"
    },
    "PontoContinuoSetup": {
      "additionalProperties": false,
      "properties": {
        "params": {
          "$ref": "#/$defs/PontoContinuoParams"
        },
        "type": {
          "const": "ponto_continuo",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "params"
      ],
      "title": "PontoContinuoSetup",
      "type": "object"
    },
    "PriceSource": {
      "enum": [
        "open",
        "high",
        "low",
        "close"
      ],
      "type": "string"
    },
    "RSI": {
      "additionalProperties": false,
      "description": "Relative Strength Index — a bounded 0-100 momentum oscillator (Wilder). Same params as a\nmoving average; the engine smooths gains and losses with Wilder's method (ADR-13: adding it\nis additive, so `schema_version` stays 1.0).",
      "properties": {
        "id": {
          "maxLength": 40,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PeriodSourceParams"
        },
        "type": {
          "const": "RSI",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "RSI",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "A reference to a value the engine can resolve at evaluation time.",
      "properties": {
        "ref": {
          "examples": [
            "sma_fast",
            "price.close",
            "candle[-1].high"
          ],
          "pattern": "^(?:[a-z_][a-z0-9_]*|price\\.(?:open|high|low|close)|candle\\[-[1-9][0-9]*\\]\\.(?:open|high|low|close))$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "max_daily_loss_percent": {
          "default": 3.0,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Max Daily Loss Percent",
          "type": "number"
        },
        "max_open_positions": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Open Positions",
          "type": "integer"
        },
        "sizing": {
          "$ref": "#/$defs/PercentRiskSizing"
        }
      },
      "required": [
        "sizing"
      ],
      "title": "Risk",
      "type": "object"
    },
    "RiskMultipleParams": {
      "additionalProperties": false,
      "properties": {
        "rr": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Rr",
          "type": "number"
        }
      },
      "required": [
        "rr"
      ],
      "title": "RiskMultipleParams",
      "type": "object"
    },
    "RiskMultipleTakeProfit": {
      "additionalProperties": false,
      "description": "Target at N times the distance to the stop.\n\nMeaningless without a stop — there is no risk to take a multiple of. The schema\ncannot say that; `semantic.py` does.",
      "properties": {
        "params": {
          "$ref": "#/$defs/RiskMultipleParams"
        },
        "type": {
          "const": "risk_multiple",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "params"
      ],
      "title": "RiskMultipleTakeProfit",
      "type": "object"
    },
    "SMA": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 40,
          "pattern": "^[a-z_][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PeriodSourceParams"
        },
        "type": {
          "const": "SMA",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "params"
      ],
      "title": "SMA",
      "type": "object"
    },
    "Setup": {
      "discriminator": {
        "mapping": {
          "mme9_breakout": "#/$defs/Mme9BreakoutSetup",
          "ponto_continuo": "#/$defs/PontoContinuoSetup",
          "structure_choch": "#/$defs/StructureChochSetup",
          "structure_continuation": "#/$defs/StructureContinuationSetup"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Mme9BreakoutSetup"
        },
        {
          "$ref": "#/$defs/PontoContinuoSetup"
        },
        {
          "$ref": "#/$defs/StructureChochSetup"
        },
        {
          "$ref": "#/$defs/StructureContinuationSetup"
        }
      ]
    },
    "SetupSide": {
      "enum": [
        "long",
        "short"
      ],
      "type": "string"
    },
    "StructureChochSetup": {
      "additionalProperties": false,
      "description": "Trade the zone the change of character left behind.",
      "properties": {
        "params": {
          "$ref": "#/$defs/StructureParams"
        },
        "type": {
          "const": "structure_choch",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "StructureChochSetup",
      "type": "object"
    },
    "StructureContinuationSetup": {
      "additionalProperties": false,
      "description": "Trade the zone a break in the trend's favour leaves behind, after a change of character.",
      "properties": {
        "params": {
          "$ref": "#/$defs/ContinuationParams"
        },
        "type": {
          "const": "structure_continuation",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "StructureContinuationSetup",
      "type": "object"
    },
    "StructureParams": {
      "additionalProperties": false,
      "description": "Shared by every setup that arms a limit order on a zone market structure left behind.\n\nNot directional: which side is traded follows the structure, so there is no `side` here.\n`stop_buffer` is a *fraction of the zone's width*, not ticks — the zone is the unit.",
      "properties": {
        "allow_secondary": {
          "default": false,
          "title": "Allow Secondary",
          "type": "boolean"
        },
        "breakeven_at_r": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 2.0,
          "title": "Breakeven At R"
        },
        "stop_buffer": {
          "default": 0.1,
          "maximum": 10,
          "minimum": 0,
          "title": "Stop Buffer",
          "type": "number"
        }
      },
      "title": "StructureParams",
      "type": "object"
    },
    "Timeframe": {
      "enum": [
        "M1",
        "M5",
        "M15",
        "M30",
        "H1",
        "H4",
        "D1",
        "W1"
      ],
      "type": "string"
    }
  },
  "$id": "https://tradeforge.dev/schema/strategy/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A complete, self-contained strategy definition.",
  "properties": {
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "entry": {
      "$ref": "#/$defs/Entry"
    },
    "exit": {
      "$ref": "#/$defs/Exit"
    },
    "indicators": {
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "maxItems": 20,
      "title": "Indicators",
      "type": "array"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "risk": {
      "$ref": "#/$defs/Risk"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "setup": {
      "anyOf": [
        {
          "$ref": "#/$defs/Setup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timeframe": {
      "$ref": "#/$defs/Timeframe"
    }
  },
  "required": [
    "schema_version",
    "name",
    "timeframe",
    "risk"
  ],
  "title": "Strategy",
  "type": "object"
}
